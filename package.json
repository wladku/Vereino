{
  "name": "vereino",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.17.1+sha512.ccbfabf7d7b6b32075088be9386fb9a2e00bb6887ef07fa56effabc890a56d53da1ccc4128d62db245fcbd3961b236d75335bdf7d5320ed6eafb7588b7ad4697",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "preinstall": "node -e \"const v = process.versions.node.split('.').map(Number); if (v[0] < 24) { console.error('Node >= 24 required'); process.exit(1); }\"",
    "postinstall": "node ./scripts/link-framework-sources.mjs",
    "setup": "node ./scripts/setup.mjs",
    "setup:classic": "yarn workspace @vereino/app setup:classic",
    "setup:reinstall": "yarn workspace @vereino/app setup:reinstall",
    "setup:reinstall:classic": "yarn workspace @vereino/app setup:reinstall:classic",
    "dev": "yarn workspace @vereino/app dev",
    "dev:classic": "yarn workspace @vereino/app dev:classic",
    "dev:verbose": "yarn workspace @vereino/app dev:verbose",
    "dev:fix-wsl-watchers": "yarn workspace @vereino/app dev:fix-wsl-watchers",
    "dev:reset": "yarn workspace @vereino/app dev:reset",
    "storybook": "yarn workspace @vereino/ui storybook",
    "build-storybook": "yarn workspace @vereino/ui build-storybook",
    "build": "yarn workspace @vereino/app build",
    "mercato": "yarn workspace @vereino/app mercato",
    "start": "yarn workspace @vereino/app start",
    "documents:collab": "yarn workspace @vereino/app documents:collab",
    "lint": "yarn workspaces foreach -Apt --include '@vereino/*' run lint",
    "ds:check": "yarn workspace @vereino/app ds:check",
    "i18n:check-hardcoded": "yarn workspace @vereino/app i18n:check-hardcoded",
    "typecheck": "yarn workspace @vereino/app typecheck",
    "typecheck:qa": "yarn workspace @vereino/app typecheck:qa",
    "test": "yarn workspaces foreach -Apt --include '@vereino/*' run test",
    "test:integration": "yarn workspace @vereino/app test:integration",
    "test:integration:ephemeral": "yarn workspace @vereino/app test:integration:ephemeral",
    "test:integration:ephemeral:start": "yarn workspace @vereino/app test:integration:ephemeral:start",
    "test:integration:ephemeral:start:verbose": "yarn workspace @vereino/app test:integration:ephemeral:start:verbose",
    "test:integration:vereino": "yarn workspace @vereino/app test:integration:vereino",
    "test:integration:vereino:start": "yarn workspace @vereino/app test:integration:vereino:start",
    "generate": "yarn workspace @vereino/app generate",
    "framework:context": "yarn workspace @vereino/app framework:context",
    "db:generate": "yarn workspace @vereino/app db:generate",
    "db:migrate": "yarn workspace @vereino/app db:migrate",
    "db:greenfield": "yarn workspace @vereino/app db:greenfield",
    "initialize": "yarn workspace @vereino/app initialize",
    "reinstall": "yarn workspace @vereino/app reinstall",
    "install-skills": "node ./scripts/install-skills.mjs",
    "harness:validate": "node ./scripts/evaluate-agent-harness.mjs",
    "harness:fixture": "node ./scripts/prepare-agent-harness-fixture.mjs",
    "harness:release": "node ./scripts/run-agent-harness-release.mjs",
    "harness:validate-knowledge-change": "node ./scripts/validate-knowledge-change.mjs",
    "lessons:check": "node ./scripts/check-lessons.mjs",
    "typecheck:packages": "yarn workspaces foreach -Apt --include '@vereino/core' --include '@vereino/db' --include '@vereino/ui' run typecheck",
    "verify": "node ./scripts/verify.mjs",
    "format": "yarn workspace @vereino/app format",
    "format:check": "yarn workspace @vereino/app format:check",
    "contracts:check": "yarn workspace @vereino/app contracts:check",
    "test:scripts": "yarn workspace @vereino/app test:scripts"
  },
  "resolutions": {
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "zod": "4.4.3",
    "handlebars": "4.7.10"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
