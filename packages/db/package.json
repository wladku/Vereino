{
  "name": "@vereino/db",
  "version": "0.1.0",
  "private": true,
  "description": "Vereino data tooling on MikroORM and PostgreSQL: shared persistence helpers, migration and seed utilities, test-database helpers.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-include=\"src/**\" --test-coverage-exclude=\"src/**/__tests__/**\" \"src/**/__tests__/*.test.{ts,mjs}\""
  },
  "peerDependencies": {
    "@mikro-orm/core": "^7.1.14",
    "@mikro-orm/postgresql": "^7.1.14"
  },
  "devDependencies": {
    "@mikro-orm/core": "^7.1.14",
    "@mikro-orm/postgresql": "^7.1.14",
    "eslint": "^9.39.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
