    "/api/club_core/settings": {
      "GET": { "probe": "read" },
      "PUT": {
        "probe": "exempt",
        "why": "Changes the settings of the caller's own club (the row is always the caller's organization); the body names no record. The one cross-club effect, the globally unique public slug (409 public_slug_taken), concerns a slug every guest can already resolve on the public page."
      }
    }
  }
}
