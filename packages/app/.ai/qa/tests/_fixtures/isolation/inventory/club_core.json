{
  "$comment": "Cross-club isolation probes of the club_core routes (#628). Format and probe kinds: _fixtures/isolation/probe.ts; completeness: yarn route-isolation:check.",
  "routes": {
    "/api/club_core/contracts": {
      "GET": [
        { "probe": "read" },
        { "probe": "read", "query": { "ids": "$B:contract" } },
        { "probe": "read", "query": { "partyId": "$B:institution" } },
        { "probe": "read", "query": { "institutionId": "$B:institution" } }
      ],
      "POST": [
        {
          "probe": "foreign-ref",
          "body": { "partyType": "institution", "partyId": "$B:institution", "kind": "other", "validFrom": "$A:today" }
        },
        {
          "probe": "foreign-ref",
          "body": { "partyType": "person", "partyId": "$B:coachPerson", "kind": "other", "validFrom": "$A:today" }
        }
      ],
      "PUT": {
        "probe": "foreign-id",
        "body": { "id": "$B:contract", "validFrom": "$A:today" },
        "headers": { "x-om-ext-optimistic-lock-expected-updated-at": "2020-01-01T00:00:00.000Z" }
      },
      "DELETE": {
        "probe": "foreign-id",
        "query": { "id": "$B:contract" },
        "headers": { "x-om-ext-optimistic-lock-expected-updated-at": "2020-01-01T00:00:00.000Z" }
      }
    },
    "/api/club_core/contracts/[id]/attachment": {
      "GET": { "probe": "foreign-id", "params": { "id": "$B:contract" } },
      "POST": {
        "probe": "foreign-id",
        "params": { "id": "$B:contract" },
        "body": { "$multipart": { "file": { "$file": "pdf" } } }
      },
      "DELETE": { "probe": "foreign-id", "params": { "id": "$B:contract" } }
    },
    "/api/club_core/institutions": {
      "GET": [{ "probe": "read" }, { "probe": "read", "query": { "ids": "$B:institution" } }],
      "POST": {
        "probe": "exempt",
        "why": "Creates an institution in the caller's club from its own fields; the body names no other record, so it cannot address club B. The institutions are read back by the GET probes."
      },
      "PUT": {
        "probe": "foreign-id",
        "body": { "id": "$B:institution", "notes": "Probe" },
        "headers": { "x-om-ext-optimistic-lock-expected-updated-at": "2020-01-01T00:00:00.000Z" }
      },
      "DELETE": {
        "probe": "foreign-id",
        "query": { "id": "$B:institution" },
        "headers": { "x-om-ext-optimistic-lock-expected-updated-at": "2020-01-01T00:00:00.000Z" }
      }
    },
    "/api/club_core/institutions/options": {
      "GET": [{ "probe": "read" }, { "probe": "read", "query": { "search": "KS" } }]
    },
    "/api/club_core/logo": {
      "POST": {
        "probe": "exempt",
        "why": "Sets the logo of the caller's own club (the target is always the caller's organization); the request names no record."
      },
      "DELETE": {
        "probe": "exempt",
        "why": "Removes the logo of the caller's own club (the target is always the caller's organization); the request names no record."
      }
    },
    "/api/club_core/options/places": {
      "GET": { "probe": "read" }
    },
    "/api/club_core/places": {
      "GET": [
        { "probe": "read" },
        { "probe": "read", "query": { "ids": "$B:place" } },
        { "probe": "read", "query": { "parentPlaceId": "$B:place" } }
      ],
      "POST": [
        { "probe": "foreign-ref", "body": { "name": "Probe", "kind": "pitch", "parentPlaceId": "$B:place" } },
        { "probe": "foreign-ref", "body": { "name": "Probe", "kind": "pitch", "ownerInstitutionId": "$B:institution" } }
      ],
      "PUT": [
        {
          "probe": "foreign-id",
          "body": { "id": "$B:place", "description": "Probe" },
          "headers": { "x-om-ext-optimistic-lock-expected-updated-at": "2020-01-01T00:00:00.000Z" }
        },
        {
          "probe": "foreign-ref",
          "body": { "id": "$A:externalPlace", "ownerInstitutionId": "$B:institution" },
          "headers": { "x-om-ext-optimistic-lock-expected-updated-at": "$A:externalPlaceUpdatedAt" }
        },
        {
          "probe": "foreign-ref",
          "body": { "id": "$A:externalPlace", "parentPlaceId": "$B:place" },
          "headers": { "x-om-ext-optimistic-lock-expected-updated-at": "$A:externalPlaceUpdatedAt" }
        }
      ],
      "DELETE": {
        "probe": "foreign-id",
        "query": { "id": "$B:place" },
        "headers": { "x-om-ext-optimistic-lock-expected-updated-at": "2020-01-01T00:00:00.000Z" }
      }
    },
    "/api/club_core/places/external": {
      "POST": {
        "probe": "foreign-ref",
        "body": {
          "name": "Hala próbna",
          "address": "ul. Próbna 1, Miasto",
          "kind": "hall",
          "ownerInstitutionId": "$B:institution"
        }
      }
    },
    "/api/club_core/places/[id]/files": {
      "GET": { "probe": "foreign-id", "params": { "id": "$B:publicPlace" } },
      "POST": {
        "probe": "foreign-id",
        "params": { "id": "$B:publicPlace" },
        "body": { "$multipart": { "file": { "$file": "png" }, "kind": "photo" } }
      }
    },
    "/api/club_core/places/[id]/files/[fileId]": {
      "DELETE": [
        { "probe": "foreign-id", "params": { "id": "$B:publicPlace", "fileId": "$B:placeFile" } },
        { "probe": "foreign-id", "params": { "id": "$A:publicPlace", "fileId": "$B:placeFile" } }
      ]
    },
    "/api/club_core/public/[clubSlug]": {
      "GET": { "probe": "read", "roles": ["anonymous"], "params": { "clubSlug": "$A:clubSlug" } }
    },
    "/api/club_core/public/[clubSlug]/events": {
      "GET": [
        { "probe": "read", "roles": ["anonymous"], "params": { "clubSlug": "$A:clubSlug" } },
        {
          "probe": "read",
          "roles": ["anonymous"],
          "params": { "clubSlug": "$A:clubSlug" },
          "query": { "section": "$A:sectionSlug" }
        },
        {
          "probe": "read",
          "roles": ["anonymous"],
          "params": { "clubSlug": "$A:clubSlug" },
          "query": { "section": "$B:sectionSlug" }
        }
      ]
