      "GET": [
        {
          "probe": "read",
          "roles": ["anonymous"],
          "params": { "clubSlug": "$A:clubSlug", "eventSlug": "$A:clubEventSlug" }
        },
        { "probe": "public", "params": { "clubSlug": "$A:clubSlug", "eventSlug": "$B:clubEventSlug" } }
      ]
    },
    "/api/club_core/public/[clubSlug]/events/[eventSlug]/files/[fileId]": {
      "GET": [
        {
          "probe": "read",
          "roles": ["anonymous"],
          "params": { "clubSlug": "$A:clubSlug", "eventSlug": "$A:clubEventSlug", "fileId": "$A:clubEventFile" }
        },
        {
          "probe": "public",
          "params": { "clubSlug": "$A:clubSlug", "eventSlug": "$A:clubEventSlug", "fileId": "$B:clubEventFile" }
        },
        {
          "probe": "public",
          "params": { "clubSlug": "$A:clubSlug", "eventSlug": "$B:clubEventSlug", "fileId": "$B:clubEventFile" }
        }
      ]
    },
    "/api/club_core/public/[clubSlug]/logo": {
      "GET": { "probe": "read", "roles": ["anonymous"], "params": { "clubSlug": "$A:clubSlug" } }
    },
    "/api/club_core/public/[clubSlug]/places/[placeSlug]/files/[fileId]": {
      "GET": [
        {
          "probe": "read",
          "roles": ["anonymous"],
          "params": { "clubSlug": "$A:clubSlug", "placeSlug": "$A:placeSlug", "fileId": "$A:placeFile" }
        },
        {
          "probe": "public",
          "params": { "clubSlug": "$A:clubSlug", "placeSlug": "$A:placeSlug", "fileId": "$B:placeFile" }
        },
        {
          "probe": "public",
          "params": { "clubSlug": "$A:clubSlug", "placeSlug": "$B:placeSlug", "fileId": "$B:placeFile" }
        }
      ]
    },
    "/api/club_core/public/[clubSlug]/sections/[sectionSlug]": {
      "GET": [
        {
          "probe": "read",
          "roles": ["anonymous"],
          "params": { "clubSlug": "$A:clubSlug", "sectionSlug": "$A:sectionSlug" }
        },
        { "probe": "public", "params": { "clubSlug": "$A:clubSlug", "sectionSlug": "$B:sectionSlug" } }
      ]
    },
    "/api/club_core/public/[clubSlug]/sections/[sectionSlug]/logo": {
      "GET": [
        {
          "probe": "read",
          "roles": ["anonymous"],
          "params": { "clubSlug": "$A:clubSlug", "sectionSlug": "$A:sectionSlug" }
        },
        { "probe": "public", "params": { "clubSlug": "$A:clubSlug", "sectionSlug": "$B:sectionSlug" } }
      ]
    },
    "/api/club_core/public/[clubSlug]/sections/[sectionSlug]/materials/[materialId]": {
      "GET": [
        {
          "probe": "read",
          "roles": ["anonymous"],
          "params": { "clubSlug": "$A:clubSlug", "sectionSlug": "$A:sectionSlug", "materialId": "$A:material" }
        },
        {
          "probe": "public",
          "params": { "clubSlug": "$A:clubSlug", "sectionSlug": "$A:sectionSlug", "materialId": "$B:material" }
        },
        {
          "probe": "public",
          "params": { "clubSlug": "$A:clubSlug", "sectionSlug": "$B:sectionSlug", "materialId": "$B:material" }
        }
      ]
    },
    "/api/club_core/sections": {
      "GET": [
        { "probe": "read" },
        { "probe": "read", "query": { "ids": "$B:publicSection" } },
        { "probe": "read", "query": { "ids": "$B:section" } }
      ],
      "POST": {
        "probe": "exempt",
        "why": "Creates a section in the caller's club from its own fields; the body names no other record, so it cannot address club B. The sections are read back by the GET probes."
      },
      "PUT": {
        "probe": "foreign-id",
        "body": { "id": "$B:section", "description": "Probe" },
        "headers": { "x-om-ext-optimistic-lock-expected-updated-at": "2020-01-01T00:00:00.000Z" }
      },
      "DELETE": {
        "probe": "foreign-id",
        "query": { "id": "$B:section" },
        "headers": { "x-om-ext-optimistic-lock-expected-updated-at": "2020-01-01T00:00:00.000Z" }
      }
    },
    "/api/club_core/sections/[id]/logo": {
      "POST": {
        "probe": "foreign-id",
        "params": { "id": "$B:publicSection" },
        "body": { "$multipart": { "file": { "$file": "png" } } },
        "headers": { "x-om-ext-optimistic-lock-expected-updated-at": "2020-01-01T00:00:00.000Z" }
      },
      "DELETE": {
        "probe": "foreign-id",
        "params": { "id": "$B:publicSection" },
        "headers": { "x-om-ext-optimistic-lock-expected-updated-at": "2020-01-01T00:00:00.000Z" }
      }
    },
    "/api/club_core/sections/[id]/materials": {
      "GET": { "probe": "foreign-id", "params": { "id": "$B:publicSection" } },
      "POST": {
        "probe": "foreign-id",
        "params": { "id": "$B:publicSection" },
        "body": { "$multipart": { "file": { "$file": "pdf" }, "title": "Probe", "isPublic": "true" } }
      }
    },
    "/api/club_core/sections/[id]/materials/[materialId]": {
      "PUT": [
        {
          "probe": "foreign-id",
          "params": { "id": "$B:publicSection", "materialId": "$B:material" },
          "body": { "title": "Probe" },
          "headers": { "x-om-ext-optimistic-lock-expected-updated-at": "2020-01-01T00:00:00.000Z" }
        },
        {
          "probe": "foreign-id",
          "params": { "id": "$A:publicSection", "materialId": "$B:material" },
          "body": { "title": "Probe" },
          "headers": { "x-om-ext-optimistic-lock-expected-updated-at": "2020-01-01T00:00:00.000Z" }
        }
      ],
      "DELETE": [
        {
          "probe": "foreign-id",
          "params": { "id": "$B:publicSection", "materialId": "$B:material" },
          "headers": { "x-om-ext-optimistic-lock-expected-updated-at": "2020-01-01T00:00:00.000Z" }
        },
        {
          "probe": "foreign-id",
          "params": { "id": "$A:publicSection", "materialId": "$B:material" },
          "headers": { "x-om-ext-optimistic-lock-expected-updated-at": "2020-01-01T00:00:00.000Z" }
