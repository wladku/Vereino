    "/api/payments/checkout": {
      "POST": {
        "probe": "foreign-ref",
        "body": {
          "chargeIds": ["$B:childCharge"]
        },
        "expect": [403],
        "why": "A charge the caller does not pay answers 403 checkout_charge_forbidden, an unknown id the same (an unknown charge is someone else's too); roles without payments.pay_online get 403 before the body is read."
      }
    },
