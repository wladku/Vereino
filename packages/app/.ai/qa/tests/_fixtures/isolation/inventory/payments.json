    "/api/payments/bank-imports": {
      "GET": {
        "probe": "read"
      },
      "POST": {
        "probe": "exempt",
        "why": "Imports an uploaded statement into the caller's club; the request names no record (the probe engine's fixed CSV cannot carry club B's payer code). The created import is read back by the GET probes."
      }
    },
