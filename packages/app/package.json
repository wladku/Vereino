{
  "name": "@vereino/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node ./scripts/setup.mjs",
    "setup:classic": "node ./scripts/setup.mjs --classic",
    "setup:reinstall": "node ./scripts/setup.mjs --reinstall",
    "setup:reinstall:classic": "node ./scripts/setup.mjs --reinstall --classic",
    "dev": "node ./scripts/dev.mjs",
    "dev:classic": "node ./scripts/dev.mjs --classic",
    "dev:verbose": "node ./scripts/dev.mjs --verbose",
    "dev:fix-wsl-watchers": "node ./scripts/fix-wsl-inotify.mjs",
    "dev:reset": "node ./scripts/dev-reset.mjs",
    "build": "yarn generate && cross-env NODE_ENV=production NODE_OPTIONS=--max-old-space-size=8192 next build",
    "mercato": "node ./scripts/mercato-cli.mjs",
    "start": "yarn mercato server start",
    "documents:collab": "node ./node_modules/@open-mercato/documents/dist/server/documents-collab-server.js",
    "lint": "eslint .",
    "ds:check": "node scripts/ds-check.mjs",
    "i18n:check-hardcoded": "node scripts/i18n-check-hardcoded.mjs",
    "format": "node scripts/vereino-format.mjs",
    "format:check": "node scripts/vereino-format.mjs --check",
    "contracts:check": "node scripts/check-vereino-contracts.mjs",
    "typecheck": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit",
    "typecheck:qa": "tsc --noEmit -p .ai/qa/tests/tsconfig.json",
    "test": "jest --config jest.config.cjs",
    "test:scripts": "node --test --experimental-test-module-mocks --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-include=\"scripts/vereino-*.mjs\" --test-coverage-include=\"scripts/check-vereino-contracts.mjs\" --test-coverage-include=\"../../scripts/verify.mjs\" --test-coverage-include=\"../../eslint.vereino.mjs\" \"scripts/__tests__/*.test.mjs\"",
    "test:integration": "npx playwright test --config .ai/qa/tests/playwright.config.ts",
    "test:integration:ephemeral": "yarn mercato test:integration",
    "test:integration:ephemeral:start": "yarn mercato test:ephemeral",
    "test:integration:ephemeral:start:verbose": "yarn mercato test:ephemeral --verbose",
    "test:integration:vereino": "node scripts/vereino-ephemeral.mjs test",
    "test:integration:vereino:start": "node scripts/vereino-ephemeral.mjs start",
    "generate": "yarn mercato generate",
    "framework:context": "node ./scripts/framework-context.mjs",
    "db:generate": "yarn mercato db generate",
    "db:migrate": "yarn mercato db migrate",
    "db:greenfield": "yarn mercato db greenfield",
    "initialize": "yarn mercato init",
    "reinstall": "yarn mercato init --reinstall"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.2",
