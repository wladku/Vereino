{
  "name": "@vereino/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable Vereino UI components: shadcn/ui-based admin components and Tailwind-styled member/public components.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-include=\"src/**\" --test-coverage-exclude=\"src/**/__tests__/**\" \"src/**/__tests__/*.test.{ts,mjs}\"",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static"
  },
  "peerDependencies": {
    "@open-mercato/shared": "0.9.0",
    "@open-mercato/ui": "0.9.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@open-mercato/shared": "0.9.0",
    "@open-mercato/ui": "0.9.0",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-themes": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/eslint-plugin-jsx-a11y": "^6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "lucide-react": "^1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.6.2",
    "tailwind-merge": "^3.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "8.3.4"
  }
}
